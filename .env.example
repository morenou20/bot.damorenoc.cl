# Servidor del bot
HOST=0.0.0.0
PORT=8080

# Token interno que debe presentar la API de damorenoc.cl
BOT_INTERNAL_KEY=genera-un-token-largo-y-aleatorio-aqui

# OpenCode Zen
OPENCODE_API_KEY=
